{
	"name": "GitHub Copilot Extensions Codespace",
	"image": "mcr.microsoft.com/devcontainers/universal:2-linux",
	"forwardPorts": [
		"3000:3000"
	],
	"portsAttributes": {
		"3000": {
			"label": "Copilot-Extension-Service",
			"onAutoForward": "silent"
		}
	},
	"postCreateCommand": "xcode-select --install && npm install",
	"customizations": {
		"vscode": {
			"extensions": [
				"GitHub.copilot"
			]
		}
	},
	"tasks": {
		"test": "echo \"No tests are defined for this repository.\"",
		"build": "npm run build",
		"launch": "npm install && npm start"
	}
}
